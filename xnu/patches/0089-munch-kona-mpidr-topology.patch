diff --git a/osfmk/arm64/exception_asm.h b/osfmk/arm64/exception_asm.h
--- a/osfmk/arm64/exception_asm.h
+++ b/osfmk/arm64/exception_asm.h
@@ -67,6 +67,10 @@
 .macro LOAD_PMAP_CPU_DATA
 	/* Get the CPU ID. */
 	mrs		$0, MPIDR_EL1
+#if defined(MUNCH)
+	/* Qualcomm Kona exposes the logical CPU in MPIDR Aff1. */
+	ubfx	$0, $0, MPIDR_AFF1_SHIFT, MPIDR_AFF1_WIDTH
+#else
 	ubfx	$1, $0, MPIDR_AFF1_SHIFT, MPIDR_AFF1_WIDTH
 	adrp	$2, EXT(cluster_offsets)@page
 	add		$2, $2, EXT(cluster_offsets)@pageoff
 	ldr		$1, [$2, $1, lsl #3]
 
 	and		$0, $0, MPIDR_AFF0_MASK
 	add		$0, $0, $1
+#endif
 
 	/* Get the PPL CPU data array. */
 	adrp	$1, EXT(pmap_cpu_data_array)@page
 	add		$1, $1, EXT(pmap_cpu_data_array)@pageoff
