+/*
+ * Minimal IOSurface accelerator for MUNCH.
+ *
+ * CoreAnimation looks for AppleM2ScalerCSCDriver while preparing IOSurface
+ * work. There is no Apple display pipeline on MUNCH; expose an identity
+ * service so userland can continue with CPU-rendered surfaces.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(MUNCH)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <sys/proc.h>
+
+class AppleM2ScalerCSCDriver : public IOService {
+	OSDeclareDefaultStructors(AppleM2ScalerCSCDriver);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleM2ScalerCSCDriver, IOService);
+
+bool
+AppleM2ScalerCSCDriver::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "AppleM2ScalerCSCUserClient");
+	registerService();
+	IOLog("MUNCH SCALER: identity service registered\n");
+	return true;
+}
+
+class AppleM2ScalerCSCUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(AppleM2ScalerCSCUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleM2ScalerCSCUserClient, IOUserClient);
+
+IOReturn
+AppleM2ScalerCSCUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+static uint64_t munch_scaler_logged;
+
+IOReturn
+AppleM2ScalerCSCUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *args, __unused IOExternalMethodDispatch *dispatch,
+    __unused OSObject *target, __unused void *reference)
+{
+	for (uint32_t i = 0; i < args->scalarOutputCount; i++) {
+		args->scalarOutput[i] = 0;
+	}
+	if (args->structureOutputDescriptor != NULL) {
+		IOByteCount len = args->structureOutputDescriptor->getLength();
+		for (IOByteCount off = 0; off < len; off += 8) {
+			static const uint64_t zero = 0;
+			args->structureOutputDescriptor->writeBytes(off, &zero,
+			    len - off < 8 ? len - off : 8);
+		}
+	} else if (args->structureOutput != NULL) {
+		bzero(args->structureOutput, args->structureOutputSize);
+	}
+	if (selector >= 64 || !(munch_scaler_logged & (1ULL << selector))) {
+		if (selector < 64) {
+			munch_scaler_logged |= 1ULL << selector;
+		}
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("MUNCH SCALER: %s sel %u in %u/%u out %u/%u -> ok\n",
+		    name, selector, args->scalarInputCount, args->structureInputSize,
+		    args->scalarOutputCount, args->structureOutputSize);
+	}
+	return kIOReturnSuccess;
+}
+#endif /* MUNCH */
