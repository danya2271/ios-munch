--- /dev/null
+++ b/pexpert/pexpert/arm64/MUNCH.h
@@ -0,0 +1,84 @@
+/*
+ * Board config for the POCO F4 ("munch", Qualcomm SM8250 /
+ * Snapdragon 865): Kryo 585 with 4+3+1 CPU capacity groups, ARMv8.2, no PAC.
+ *
+ * Generic ARM like BCM2837 (no APPLE_ARM64_ARCH_FAMILY: none of Apple's
+ * implementation-defined system registers exist), 16K pages and GICv3 like
+ * VMAPPLE. Unlike VMAPPLE the GIC has two security states (GICD_TYPER
+ * SecurityExtn=1): Group 0 belongs to TrustZone, so every interrupt,
+ * including the timer, is a Group 1 IRQ taken through sleh_irq().
+ */
+
+#ifndef _PEXPERT_ARM64_MUNCH_H
+#define _PEXPERT_ARM64_MUNCH_H
+
+#define NO_MONITOR                1
+#define NO_ECORE                  1
+
+#define MUNCH                     1
+
+/*
+ * The first Munch profile exposes the eight DTS CPUs but starts only the boot
+ * CPU. Heterogeneous scheduling and secondary CPU bring-up remain separate
+ * work; all cores use the same ARMv8.2/64-byte-line architectural contract.
+ */
+#define MUNCH_SMP_MAX_CPUS         8
+#define BOARD_SMP_MAX_CPUS         MUNCH_SMP_MAX_CPUS
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__              8
+#define __ARM_VMSA__              8
+#define __ARM_VFP__               4
+#define __ARM_COHERENT_CACHE__    1
+#define __ARM_DEBUG__             7
+#define __ARM_ENABLE_SWAP__       1
+#define __ARM_V8_CRYPTO_EXTENSIONS__ 1
+#define __ARM_PAN_AVAILABLE__     1
+#define __ARM_16K_PG__            1
+
