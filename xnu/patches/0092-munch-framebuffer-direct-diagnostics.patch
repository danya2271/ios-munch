diff --git a/iokit/Kernel/arm/MunchFramebuffer.cpp b/iokit/Kernel/arm/MunchFramebuffer.cpp
--- a/iokit/Kernel/arm/MunchFramebuffer.cpp
+++ b/iokit/Kernel/arm/MunchFramebuffer.cpp
@@ -112,5 +112,6 @@
 	uint32_t      fSwapID;
 	bool          fConsolePaused;
