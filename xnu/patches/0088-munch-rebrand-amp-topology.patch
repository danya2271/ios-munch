diff --git a/bsd/pthread/munch_pthread_init.c b/bsd/pthread/munch_pthread_init.c
new file mode 100644
index 0000000000000000000000000000000000000000..0bcc284fac793c0cec3379c5b73926404b22a733
--- /dev/null
+++ b/bsd/pthread/munch_pthread_init.c
@@ -0,0 +1,26 @@
+/* Built-in provider: Apple libpthread-514.100.2, paired with xnu-8796.141.3. */
+#if defined(ARM64_BOARD_CONFIG_MUNCH)
+#include "munch_pthread_compat.h"
+#include "munch_libpthread/kern/kern_init.c"
+
+/* Keep the provider's full layout within the kernel's reserved storage. */
+_Static_assert(sizeof(struct ksyn_waitq_element) == 56,
+    "update MUNCH ksyn storage in sys/pthread_internal.h");
+
+/* Restore the startup interface after compiling the provider's kext code. */
+#define XNU_KERNEL_PRIVATE 1
+#include <kern/startup.h>
+#include <pexpert/pexpert.h>
+
+__startup_func
+static void
+munch_pthread_register(void)
+{
+    kern_return_t kr = munch_pthread_start(NULL, NULL);
+    if (kr != KERN_SUCCESS || munch_pthread_kern == NULL) {
+        panic("MUNCH: pthread provider registration failed: %d", kr);
+    }
+    kprintf("MUNCH pthread: libpthread-514.100.2 registered\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_SECOND, munch_pthread_register);
+#endif /* ARM64_BOARD_CONFIG_MUNCH */
