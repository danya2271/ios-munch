+bool
+hakios_gpu_dvfs_enabled(void)
+{
+	return gpu_dvfs_enabled != 0 && !gpu_dvfs_failed && gpu_opp_count > 2;
+}
+
+void
+hakios_gpu_dvfs_tick(void)
+{
+	uint64_t now, elapsed_ns, busy_ns;
+	uint32_t done, pending, target, utilization;
+
+	if (!gpu_kept || !gmu_talks || !hakios_gpu_dvfs_enabled()) {
+		return;
+	}
+	gpu_times();
+	now = mach_absolute_time();
+	if (now <= gpu_dvfs_last) {
+		gpu_dvfs_last = now;
+		gpu_dvfs_busy_ticks = 0;
+		return;
+	}
+	absolutetime_to_nanoseconds(now - gpu_dvfs_last, &elapsed_ns);
+	gpu_dvfs_last = now;
+	if (elapsed_ns == 0) {
+		gpu_dvfs_busy_ticks = 0;
+		return;
+	}
+	to_memory(core_scratch.memory, 4096);
+	done = *(volatile uint32_t *)(core_scratch.memory + GPU_FENCE_AT);
+	pending = gpu_fence - done;
+	busy_ns = gpu_dvfs_busy_ticks * NSEC_PER_SEC / 19200000ull;
+	gpu_dvfs_busy_ticks = 0;
+	if (busy_ns > elapsed_ns) {
+		busy_ns = elapsed_ns;
+	}
+	utilization = (uint32_t)(busy_ns * 100 / elapsed_ns);
+	if (pending >= 2) {
+		utilization = 100;
+	} else if (pending != 0 && utilization < 70) {
+		utilization = 70;
+	}
+	if (utilization >= 90) {
+		target = gpu_opp_count - 1;
+	} else if (utilization >= 70) {
+		target = gpu_opp_count - 2;
+	} else if (utilization >= 40) {
+		target = gpu_opp_count > 3 ? gpu_opp_count - 3 : 1;
+	} else if (utilization >= 15) {
+		target = gpu_opp_count > 4 ? gpu_opp_count - 4 : 1;
+	} else {
+		target = 1;
+	}
+	if (target < 1) {
+		target = 1;
+	}
+	if (target > gpu_opp_index) {
+		gpu_dvfs_idle_samples = 0;
+		target = gpu_opp_index + 1;
+	} else if (target < gpu_opp_index) {
+		if (++gpu_dvfs_idle_samples < 4) {
+			return;
+		}
+		gpu_dvfs_idle_samples = 0;
+		target = gpu_opp_index - 1;
+	} else {
+		gpu_dvfs_idle_samples = 0;
+		return;
+	}
+	{
+		uint32_t vote[4] = { 0, 1, target, HFI_NO_INDEX };
+
+		if (!hfi_send("GPU DVFS frequency vote", HFI_GX_BW_PERF_VOTE, vote, 4)) {
+			gpu_dvfs_failed = true;
+			printf("adreno: gpu: frequency scaling disabled after a failed GMU vote\n");
+			return;
+		}
+	}
+	gpu_opp_index = target;
+	core_khz = gpu_opp_khz[target];
+	printf("adreno: gpu: frequency %u MHz (GPU busy %u%%)\n", core_khz / 1000, utilization);
+}
